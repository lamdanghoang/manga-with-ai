{
  "name": "@manga-with-ai/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--dns-result-order=ipv4first' tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "mcp": "tsx src/mcp-server.ts",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1060.0",
    "@google/genai": "1.52.0",
    "@manga-with-ai/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@prisma/client": "6.19.3",
    "@sentry/node": "8.53.0",
    "bullmq": "5.78.0",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "jsonwebtoken": "9.0.3",
    "n-payment": "0.25.0",
    "viem": "2.52.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.19.19",
    "prisma": "6.19.3",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  }
}
